<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!--
    The engine is a leaf, like MtgEngine.Domain: no ASP.NET, no EF Core, no reference back to
    MtgEngine.Api. ArchitectureTests enforces it rather than trusting this comment.
  -->
  <ItemGroup>
    <ProjectReference Include="..\MtgEngine.Domain\MtgEngine.Domain.csproj" />
  </ItemGroup>

</Project>
