## .NET / C# gitignore

# Build results
bin/
obj/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docview

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Rider
.idea/

# VS Code
.vscode/

# Logs
*.log

# OS
.DS_Store
Thumbs.db
.claude/

# Local secrets — never commit
appsettings.Development.json
*.db

# Redirected stderr from local runs
*.err

# SQLite side files: binary, rewritten on every request, and meaningless in a diff.
*.db-shm
*.db-wal

# Scryfall bulk data (~700 MB) is downloaded on startup, never checked in.
bulk-data/

# Local run logs
api-run.log*
client-run.log*
server.err
server.log
