## .NET / C# gitignore

# Build results
bin/
obj/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docview

# NuGet
*.nupkg
*.snupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# Rider
.idea/

# VS Code
.vscode/

# Logs
*.log

# OS
.DS_Store
Thumbs.db
# Claude Code: machine-specific settings stay out, but the docs gate is shared code —
# CLAUDE.md calls it enforced, which it can only be if it ships with the repo.
.claude/*
!.claude/settings.json
!.claude/hooks/

# Local secrets — never commit
appsettings.Development.json
*.db

# Redirected stderr from local runs
*.err

# SQLite side files: binary, rewritten on every request, and meaningless in a diff.
*.db-shm
*.db-wal

# Scryfall bulk data (~700 MB) is downloaded on startup, never checked in.
bulk-data/

# Local run logs
api-run.log*
client-run.log*
server.err
server.log

# Hand-made SQLite backups taken before destructive migrations. `*.db` does not
# match these — the extension is no longer last — so without this rule a 19 MB
# database snapshot gets committed by anyone running `git add -A`.
*.db.bak-*
scratch-coord/
trigger-audit-output.txt

# Agent orchestration runtime state (CARD_ENGINE_PLAN.md § "Enforcement"). The launch
# ledger, the per-worktree manifest/heartbeat/report that agent-guard.js writes, the ready
# markers the merge queue reads, and per-agent scratch. All of it is machine-local signalling
# about a run, not source — and /tmp is shared across agents, so scratch lives here instead.
.agents/
.agent/
.agent-tmp/
ready/

# Local QA captures and test output; retain the harness source and research notes.
*.trx
/tools/TableQa/**/*.png
/tools/TableQa/layout-acceptance-*/
/tools/TableQa/library-payment-live-failure.html
/prototypes/table/preview/
/research/board-implementation/*.png
/library-payment-qa-preview.json
/library-payment-qa-snapshot.json
