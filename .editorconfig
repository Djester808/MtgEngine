root = true

[*]
indent_style = space
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

# C# formatting rules
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# Naming conventions — private fields use _camelCase (underscore prefix)
dotnet_naming_rule.private_fields_underscore_camel.severity = suggestion
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_style.required_prefix = _

# Sort using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Unnecessary code
dotnet_diagnostic.IDE0001.severity = suggestion  # Simplify name
dotnet_diagnostic.IDE0005.severity = warning      # Remove unnecessary using
dotnet_diagnostic.IDE0055.severity = warning      # Fix formatting
dotnet_diagnostic.IDE0051.severity = warning      # Remove unused private member
dotnet_diagnostic.IDE0052.severity = suggestion   # Remove unread private member
dotnet_diagnostic.IDE1006.severity = none         # Naming — handled by naming rules above

# Roslyn quality rules. AnalysisMode=Default gives a clean baseline; below we
# opt IN a curated set of correctness-flavored rules as build-failing errors
# (TreatWarningsAsErrors is on). Style/micro-perf/culture-noise rules stay off.
dotnet_diagnostic.CA1001.severity = error         # type owns an IDisposable field but isn't IDisposable (leak)
dotnet_diagnostic.CA1310.severity = error         # string compare needs an explicit StringComparison (correctness)
dotnet_diagnostic.CA2016.severity = error         # forward the CancellationToken you were given
dotnet_diagnostic.CA1068.severity = error         # CancellationToken must be the last parameter

# Deliberately off:
dotnet_diagnostic.CA1711.severity = none          # "Collection" is a real domain entity, not a suffix smell
dotnet_diagnostic.CA1848.severity = none          # LoggerMessage delegates — not worth it at this scale
dotnet_diagnostic.CA2007.severity = none          # ConfigureAwait(false) — not needed in ASP.NET Core
dotnet_diagnostic.CA1862.severity = none          # fires on EF LINQ .ToLower() compares, where the "fix" breaks SQL translation

# Private fields must be _camelCase (was suggestion; now enforced).
dotnet_naming_rule.private_fields_underscore_camel.severity = warning

[*.{json,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
