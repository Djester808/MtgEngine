{
  "Jwt": {
    // Never commit a real secret here. Must be 32+ bytes. Supply it out-of-band:
    //   dev:  dotnet user-secrets set "Jwt:Secret" "<random 32+ bytes>" --project MtgEngine.Api
    //   prod: environment variable  Jwt__Secret
    "Secret": ""
  },
  "Anthropic": {
    // Never commit a real key here. Supply it out-of-band:
    //   dev:  dotnet user-secrets set "Anthropic:ApiKey" "sk-ant-..." --project MtgEngine.Api
    //   prod: environment variable  Anthropic__ApiKey
    "ApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MtgEngine": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:7001"
      },
      "Http": {
        "Url": "http://localhost:5001"
      }
    }
  }
}
