<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UserSecretsId>c08fa7fc-c4cf-464d-912e-e908d84a6322</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MtgEngine.Domain\MtgEngine.Domain.csproj" />
    <ProjectReference Include="..\MtgEngine.Rules\MtgEngine.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The prompt/response helpers are internal by design but are pure logic worth unit testing. -->
    <InternalsVisibleTo Include="MtgEngine.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The deckbuilding doctrine ships with the app: it is injected into every AI prompt,
         so it has to be present at runtime, not just in the source tree. -->
    <Content Include="Knowledge\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Comprehensive Rules ship the same way: the knowledge base parses this
         file at startup, so a new rules release is a file swap, not a code change. -->
    <Content Include="Knowledge\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
  </ItemGroup>
</Project>
