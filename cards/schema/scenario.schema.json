{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "$ref": "#/$defs/Scenario",
  "$defs": {
    "Scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ScenarioSource"
        },
        "setup": {
          "$ref": "#/$defs/ScenarioSetup"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioStep"
          }
        },
        "expect": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Expectation"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source",
        "setup",
        "steps",
        "expect"
      ],
      "description": "A test as data: a board, a sequence of actions, and what must be true afterwards. A ruling, a rulebook example, a bug report and a hand-written check all take this shape, and the engine runs them all through the same runner."
    },
    "ScenarioSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeneratedSource"
        },
        {
          "$ref": "#/$defs/HumanSource"
        },
        {
          "$ref": "#/$defs/ReportSource"
        },
        {
          "$ref": "#/$defs/RulebookExampleSource"
        },
        {
          "$ref": "#/$defs/RulingSource"
        }
      ]
    },
    "ScenarioSetup": {
      "type": "object",
      "properties": {
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlayerSetup"
          }
        },
        "activePlayer": {
          "type": "string"
        },
        "startAt": {
          "type": "string",
          "enum": [
            "Untap",
            "Upkeep",
            "Draw",
            "PrecombatMain",
            "BeginningOfCombat",
            "DeclareAttackers",
            "DeclareBlockers",
            "FirstStrikeCombatDamage",
            "CombatDamage",
            "EndOfCombat",
            "PostcombatMain",
            "End",
            "Cleanup"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "turn": {
          "type": "integer"
        },
        "autoAnswer": {
          "type": "boolean",
          "description": "Who answers the questions the game stops to ask (CR 101.4). A scenario generated from the definition \u2014 the smoke scenario \u2014 sets this true: it has never seen the game\u0027s objects, so it cannot name an option id, and the runner answers every question with the first legal option, recorded as a real AnswerChoice command so the log still replays. A hand-written scenario leaves it false and answers itself with AnswerStep: the answer it picks is usually the point of the test, and a runner that answered first-legal would erase it."
        }
      },
      "additionalProperties": false,
      "required": [
        "players",
        "activePlayer"
      ],
      "description": "The board before the first step. Cards are named; the runner resolves names through the definition store."
    },
    "ScenarioStep": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivateStep"
        },
        {
          "$ref": "#/$defs/AddManaStep"
        },
        {
          "$ref": "#/$defs/AdvanceToStep"
        },
        {
          "$ref": "#/$defs/AnswerStep"
        },
        {
          "$ref": "#/$defs/AttackStep"
        },
        {
          "$ref": "#/$defs/BlockStep"
        },
        {
          "$ref": "#/$defs/CastStep"
        },
        {
          "$ref": "#/$defs/ExpectRefusedStep"
        },
        {
          "$ref": "#/$defs/PassStep"
        },
        {
          "$ref": "#/$defs/PlayLandStep"
        },
        {
          "$ref": "#/$defs/ResolveAllStep"
        }
      ],
      "description": "One thing a player does, or the runner does for them."
    },
    "Expectation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttachedToIs"
        },
        {
          "$ref": "#/$defs/ControlledBy"
        },
        {
          "$ref": "#/$defs/CountersAre"
        },
        {
          "$ref": "#/$defs/EventLogged"
        },
        {
          "$ref": "#/$defs/GameOver"
        },
        {
          "$ref": "#/$defs/HasKeywordNow"
        },
        {
          "$ref": "#/$defs/InZone"
        },
        {
          "$ref": "#/$defs/Life"
        },
        {
          "$ref": "#/$defs/ManaPoolIs"
        },
        {
          "$ref": "#/$defs/PlayerCountersAre"
        },
        {
          "$ref": "#/$defs/PowerToughness"
        },
        {
          "$ref": "#/$defs/Shuffled"
        },
        {
          "$ref": "#/$defs/StackEmpty"
        },
        {
          "$ref": "#/$defs/TappedIs"
        },
        {
          "$ref": "#/$defs/TypesAre"
        },
        {
          "$ref": "#/$defs/ZoneCount"
        }
      ],
      "description": "What must hold after the steps."
    },
    "GeneratedSource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "GeneratedSource"
        },
        "generator": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "generator"
      ],
      "description": "Generated by the pipeline from the definition itself: the smoke scenario."
    },
    "HumanSource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "HumanSource"
        },
        "by": {
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "by"
      ]
    },
    "ReportSource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ReportSource"
        },
        "gameId": {
          "type": "string"
        },
        "eventIndex": {
          "type": "integer"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "gameId",
        "eventIndex"
      ],
      "description": "A player\u0027s report from a game log position."
    },
    "RulebookExampleSource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "RulebookExampleSource"
        },
        "rule": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "rule",
        "text"
      ],
      "description": "An \u0022Example:\u0022 paragraph from the Comprehensive Rules, by rule number."
    },
    "RulingSource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "RulingSource"
        },
        "oracleId": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "oracleId",
        "comment"
      ],
      "description": "A Scryfall ruling, quoted, on the card the scenario belongs to."
    },
    "PlayerSetup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "life": {
          "type": "integer"
        },
        "battlefield": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CardRef"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "hand": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CardRef"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "library": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CardRef"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "graveyard": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CardRef"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "exile": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CardRef"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CardRef"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "manaPool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "counters": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "ActivateStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ActivateStep"
        },
        "player": {
          "type": "string"
        },
        "card": {
          "type": "string"
        },
        "abilityIndex": {
          "type": "integer"
        },
        "targets": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "x": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "costChoices": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "costObjects": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The objects the activation cost eats, chosen at CR 602.2b and paid at CR 601.2h \u2014 the same field, and the same reason, as CastStep.CostObjects."
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "player",
        "card",
        "abilityIndex"
      ],
      "description": "A player activates an ability (CR 602.2), by its index in the face\u0027s ability list."
    },
    "AddManaStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "AddManaStep"
        },
        "player": {
          "type": "string"
        },
        "mana": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "player",
        "mana"
      ]
    },
    "AdvanceToStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "AdvanceToStep"
        },
        "step": {
          "type": "string",
          "enum": [
            "Untap",
            "Upkeep",
            "Draw",
            "PrecombatMain",
            "BeginningOfCombat",
            "DeclareAttackers",
            "DeclareBlockers",
            "FirstStrikeCombatDamage",
            "CombatDamage",
            "EndOfCombat",
            "PostcombatMain",
            "End",
            "Cleanup"
          ]
        },
        "turn": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "step"
      ]
    },
    "AnswerStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "AnswerStep"
        },
        "player": {
          "type": "string"
        },
        "answer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "player",
        "answer"
      ],
      "description": "Answer the pending question: a choice\u0027s option ids, in order."
    },
    "AttackStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "AttackStep"
        },
        "player": {
          "type": "string"
        },
        "attacks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attack"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "player",
        "attacks"
      ]
    },
    "BlockStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "BlockStep"
        },
        "player": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "player",
        "blocks"
      ]
    },
    "CastStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "CastStep"
        },
        "player": {
          "type": "string"
        },
        "card": {
          "type": "string"
        },
        "targets": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "x": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "modes": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "costChoices": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "alternativeCost": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "costObjects": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The objects a printed cost eats, chosen as the spell is cast (CR 601.2c) and paid for at CR 601.2h: the creature a \u0022Sacrifice a creature\u0022 cost sacrifices, the cards an exile cost exiles. Without them the engine has to guess, and refuses instead \u2014 \u0022There are not enough permanents to sacrifice\u0022 is the refusal a scenario gets for leaving this null."
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "player",
        "card"
      ],
      "description": "A player casts a card (CR 601.2). Cards, targets and cost objects are named by the alias the setup gave them, or by card name where no name repeats."
    },
    "ExpectRefusedStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ExpectRefusedStep"
        },
        "attempt": {
          "$ref": "#/$defs/ScenarioStep"
        },
        "reasonContains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt"
      ],
      "description": "The next step must be refused by the engine, with a reason containing the text."
    },
    "PassStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "PassStep"
        },
        "player": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "player"
      ]
    },
    "PlayLandStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "PlayLandStep"
        },
        "player": {
          "type": "string"
        },
        "card": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "player",
        "card"
      ]
    },
    "ResolveAllStep": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ResolveAllStep"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "description": "Every player passes until the stack is empty."
    },
    "AttachedToIs": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "AttachedToIs"
        },
        "card": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "card",
        "to"
      ],
      "description": "One permanent is attached to another (CR 301.5, 303.4f): the Aura, Equipment or Fortification named by Card is attached to the object named by To. This is what an Aura scenario means; asserting the Aura is merely on the battlefield passes for a moment and then stops, because CR 704.5m puts an unattached Aura into its owner\u0027s graveyard. Named for TappedIs and not AttachedTo, which is the predicate a card\u0027s own filter uses (\u0022Auras attached to it\u0022); one discriminator, one meaning."
    },
    "ControlledBy": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ControlledBy"
        },
        "card": {
          "type": "string"
        },
        "player": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "card",
        "player"
      ]
    },
    "CountersAre": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "CountersAre"
        },
        "card": {
          "type": "string"
        },
        "counter": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "card",
        "counter",
        "count"
      ]
    },
    "EventLogged": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "EventLogged"
        },
        "eventKind": {
          "type": "string"
        },
        "card": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "eventKind"
      ],
      "description": "An event of the given kind was logged, optionally mentioning a card."
    },
    "GameOver": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "GameOver"
        },
        "winner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "HasKeywordNow": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "HasKeywordNow"
        },
        "card": {
          "type": "string"
        },
        "keyword": {
          "type": "string",
          "enum": [
            "Deathtouch",
            "Defender",
            "DoubleStrike",
            "Enchant",
            "Equip",
            "FirstStrike",
            "Flash",
            "Flying",
            "Haste",
            "Hexproof",
            "Indestructible",
            "Intimidate",
            "Landwalk",
            "Lifelink",
            "Protection",
            "Reach",
            "Shroud",
            "Trample",
            "Vigilance",
            "Ward",
            "Banding",
            "Rampage",
            "CumulativeUpkeep",
            "Flanking",
            "Phasing",
            "Buyback",
            "Shadow",
            "Cycling",
            "Echo",
            "Horsemanship",
            "Fading",
            "Kicker",
            "Flashback",
            "Madness",
            "Fear",
            "Morph",
            "Amplify",
            "Provoke",
            "Storm",
            "Affinity",
            "Entwine",
            "Modular",
            "Sunburst",
            "Bushido",
            "Soulshift",
            "Splice",
            "Offering",
            "Ninjutsu",
            "Epic",
            "Convoke",
            "Dredge",
            "Transmute",
            "Bloodthirst",
            "Haunt",
            "Replicate",
            "Forecast",
            "Graft",
            "Recover",
            "Ripple",
            "SplitSecond",
            "Suspend",
            "Vanishing",
            "Absorb",
            "AuraSwap",
            "Delve",
            "Fortify",
            "Frenzy",
            "Gravestorm",
            "Poisonous",
            "Transfigure",
            "Champion",
            "Changeling",
            "Evoke",
            "Hideaway",
            "Prowl",
            "Reinforce",
            "Conspire",
            "Persist",
            "Wither",
            "Retrace",
            "Devour",
            "Exalted",
            "Unearth",
            "Cascade",
            "Annihilator",
            "LevelUp",
            "Rebound",
            "UmbraArmor",
            "Infect",
            "BattleCry",
            "LivingWeapon",
            "Undying",
            "Miracle",
            "Soulbond",
            "Overload",
            "Scavenge",
            "Unleash",
            "Cipher",
            "Evolve",
            "Extort",
