            "JumpStart",
            "Mentor",
            "Afterlife",
            "Riot",
            "Spectacle",
            "Escape",
            "Companion",
            "Mutate",
            "Encore",
            "Boast",
            "Foretell",
            "Demonstrate",
            "DayboundAndNightbound",
            "Disturb",
